// Small controls shared by the screens.

import { Theme } from "theme.slint";

export enum ButtonKind { primary, secondary, outline, ghost, danger }

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <length> font-size: 15px;
    callback clicked();

    height: 40px;
    min-width: label.preferred-width + 32px + (root.has-icon ? 18px : 0px);
    border-radius: Theme.radius-control;
    border-width: root.kind == ButtonKind.outline ? 1px : 0px;
    border-color: Theme.border;
    background: !root.enabled ? (root.kind == ButtonKind.primary ? Theme.accent-muted : Theme.surface)
        : root.kind == ButtonKind.primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.kind == ButtonKind.danger ? (touch.has-hover ? Theme.danger-bg-hover : Theme.danger-bg)
        : root.kind == ButtonKind.ghost ? (touch.has-hover ? Theme.surface : transparent)
        : root.kind == ButtonKind.outline ? (touch.has-hover ? Theme.surface : transparent)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface-2);
    opacity: root.enabled || root.kind == ButtonKind.primary ? 1.0 : 0.5;
    animate background { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.has-icon: Image {
            source: root.icon;
            width: 16px;
            colorize: label.color;
            y: (parent.height - self.height) / 2;
            height: 16px;
        }
        label := Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
            color: root.kind == ButtonKind.primary ? Theme.on-accent
                : root.kind == ButtonKind.danger ? Theme.danger
                : Theme.text;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 14px;
    in property <bool> filled: true;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.surface-hover : (root.filled ? Theme.surface-2 : transparent);
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: Theme.text-dim;
    }
}

export component Link inherits Text {
    callback clicked();
    color: touch.has-hover ? Theme.accent-hover : Theme.accent;
    font-size: 15px;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 1px;
        background: root.color;
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
}

export component StatusDot inherits Rectangle {
    in property <color> dot-color;
    in property <bool> hollow: false;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.hollow ? transparent : root.dot-color;
    border-width: root.hollow ? 2px : 0px;
    border-color: root.dot-color;
}

// One row of a segmented control.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> mono: true;
    callback changed(int);

    height: 40px;
    border-radius: Theme.radius-control;
    background: Theme.surface;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[index] in root.options: Rectangle {
            min-width: option-text.preferred-width + 23px;
            border-radius: Theme.radius-control - 2px;
            background: index == root.selected ? Theme.accent : (seg-touch.has-hover ? Theme.surface-2 : transparent);
            seg-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(index); }
            }
            option-text := Text {
                text: option;
                font-size: 14px;
                font-family: root.mono ? Theme.mono : "";
                font-weight: index == root.selected ? 600 : 400;
                color: index == root.selected ? Theme.on-accent : Theme.text-dim;
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? Theme.accent : Theme.surface-2;
    opacity: root.enabled ? 1.0 : 0.5;
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? Theme.on-accent : Theme.text-faint;
        animate x { duration: 120ms; }
    }
}

export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <float> step: 1;
    callback moved(float);

    height: 24px;
    property <float> fraction: (root.value - root.minimum) / (root.maximum - root.minimum);

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-2;
        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    knob := Rectangle {
        x: (root.width - self.width) * root.fraction;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
    function set-from(x: length) {
        let f = clamp((x - knob.width / 2) / (root.width - knob.width), 0, 1);
        let raw = root.minimum + f * (root.maximum - root.minimum);
        root.moved(round(raw / root.step) * root.step);
    }
}

// Single-line text entry in the app's style.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    callback accepted(string);
    callback edited(string);

    height: 42px;
    border-radius: Theme.radius-control;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    public function focus-input() {
        input.focus();
    }

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        text <=> root.text;
        font-size: 15px;
        font-family: root.mono ? Theme.mono : "";
        color: Theme.text;
        selection-background-color: Theme.accent-muted;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
    if root.text == "": Text {
        x: 14px;
        text: root.placeholder;
        font-size: 15px;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
}

// Small uppercase heading ("NETWORK", "VIDEO").
export component Eyebrow inherits Text {
    font-size: 12px;
    letter-spacing: 1.5px;
    color: Theme.text-dim;
}

// Error / notice strip.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> error: true;
    callback dismissed();

    height: msg.preferred-height + 18px;
    border-radius: Theme.radius-control;
    background: root.error ? Theme.danger-bg : Theme.surface;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 5px;
        spacing: 8px;
        msg := Text {
            text: root.text;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: center;
            color: root.error ? Theme.danger : Theme.text;
        }
        Rectangle {
            width: 23px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.dismissed(); }
            }
            Image {
                source: @image-url("icons/close.svg");
                width: 10px;
                colorize: msg.color;
            }
        }
    }
}
